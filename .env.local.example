# Google Sheets (service account) — see docs/03-architecture.md
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# Auth.js (NextAuth v5) — generate AUTH_SECRET with `npx auth secret`
AUTH_SECRET=

# Google OAuth (sign-in)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Access control — set at least one. ALLOWED_EMAILS is the one to use for a
# personal Gmail account (comma-separated exact addresses); ALLOWED_EMAIL_DOMAIN
# is for a company Workspace domain. Either can grant access.
ALLOWED_EMAILS=
ALLOWED_EMAIL_DOMAIN=
